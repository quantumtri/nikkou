---
import { getT } from '../i18n/index.js';
const { lang, alternates } = Astro.props;
const t = getT(lang);
---
<details class="lang">
  <summary aria-label={t.common.language}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3z"/></svg>
    <span>{t.short}</span>
  </summary>
  <ul>
    {alternates.map((a) => (
      <li><a href={a.href} lang={getT(a.lang).htmlLang} hreflang={getT(a.lang).htmlLang} aria-current={a.lang === lang ? 'true' : undefined}>{getT(a.lang).nativeName}</a></li>
    ))}
  </ul>
</details>

<script>
  document.querySelectorAll<HTMLDetailsElement>('details.lang').forEach((d) => {
    document.addEventListener('click', (e) => { if (!d.contains(e.target as Node)) d.open = false; });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') d.open = false; });
  });
</script>
