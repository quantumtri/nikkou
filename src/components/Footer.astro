---
import { Image } from 'astro:assets';
import logo from '../assets/logo-wordmark.png';
import { cfg, pick, waLinkFor } from '../lib/content.js';
import { getT, localePath, loc } from '../i18n/index.js';

const { home = false, lang = 'id' } = Astro.props;
const t = getT(lang);
const f = t.common.footer;
const waLink = waLinkFor(lang);
const p = home ? '' : localePath(lang, '/');
const address = pick(loc(cfg.address, lang), 'Alamat kantor, kota');
const hours = pick(loc(cfg.hours, lang), 'Jam operasional');
const company = cfg.company ?? cfg.brand;
---
<footer class="foot">
  <div class="foot-in">
    <div class="foot-top">
      <div class="foot-brand">
        <div class="foot-logo"><Image src={logo} alt="NIKKOU" width={208} /></div>
        {(address || hours) && (
          <p>{address}{address && hours && <br />}{hours}</p>
        )}
      </div>
      <div class="foot-col">
        <b>{f.pages}</b>
        <a class="footlink" href={`${p}#teknologi`}>{f.tech}</a>
        <a class="footlink" href={`${p}#produk`}>{f.products}</a>
        <a class="footlink" href={`${p}#cara-pakai`}>{f.usage}</a>
        <a class="footlink" href={`${p}#faq`}>{f.faq}</a>
        <a class="footlink" href={localePath(lang, '/testimoni')}>{f.testimonials}</a>
      </div>
      <div class="foot-col">
        <b>{f.help}</b>
        <a class="footlink" href={waLink} target="_blank" rel="noopener">WhatsApp</a>
      </div>
    </div>
    <div class="foot-bottom">
      <div>{f.disclaimer}</div>
      <div>{f.copy(company)}</div>
    </div>
  </div>
</footer>
