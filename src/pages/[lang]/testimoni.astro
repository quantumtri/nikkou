---
import TestimonialsPage from '../../components/TestimonialsPage.astro';
import { locales, defaultLocale } from '../../i18n/index.js';

export function getStaticPaths() {
  return locales.filter((l) => l !== defaultLocale).map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params;
---
<TestimonialsPage lang={lang} />
